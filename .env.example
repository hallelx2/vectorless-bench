# Copy to .env and fill in. The bench reads these from the environment.

# --- Vectorless (system under test) ---
VECTORLESS_API_KEY=vl_live_xxx
VECTORLESS_BASE_URL=http://localhost:8080

# --- baselines that call providers ---
OPENAI_API_KEY=sk-xxx          # vector_rag embeddings, full_context, judge
ANTHROPIC_API_KEY=sk-ant-xxx   # if model=claude-* for full_context/judge

# --- vector_rag (pgvector backend) ---
VLBENCH_PG_DSN=postgresql://user:pass@localhost:5432/vlbench

# --- PageIndex baseline (api mode) ---
PAGEINDEX_API_KEY=pi_xxx

# --- FinanceBench documents ---
VLBENCH_FINANCEBENCH_DOCS=data/financebench/docs
